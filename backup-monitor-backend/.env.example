# API only listens locally by default. Use :8080 only when a reverse proxy or
# firewall protects the host.
API_BIND_ADDR=127.0.0.1:8080
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Secret values are intentionally blank so copying this file cannot start the
# backend with public placeholder credentials.
ADMIN_USER=admin
ADMIN_PASSWORD=
# Generate at least 32 random characters; never reuse the admin password.
JWT_SECRET=

SSH_HOST=192.168.37.130:22
SSH_USER=backup-monitor
SSH_PASSWORD=
# SSH_PRIVATE_KEY_PATH=C:\Users\your-user\.ssh\id_ed25519
# SSH_PRIVATE_KEY_PASSPHRASE=replace_if_key_is_encrypted

# Secure default: pin the server host key. Populate this file with ssh-keyscan
# after verifying the fingerprint out of band.
SSH_KNOWN_HOSTS=
SSH_INSECURE_IGNORE_HOST_KEY=false

# Keep false for a dedicated unprivileged SSH account. If SSH_USER=root is
# unavoidable, explicitly set this to true after reviewing the risk.
ALLOW_ROOT_SSH=false