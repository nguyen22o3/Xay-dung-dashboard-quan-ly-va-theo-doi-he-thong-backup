[Unit]
Description=Backup Monitor privileged local host agent (private Unix socket only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
UMask=0077
ExecStart=/usr/local/libexec/backup-monitor/backup-manager agent-serve
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
# Jobs detached by the existing scheduler must survive agent updates. The API
# has an explicit task-cancel operation; restarting this service is not cancel.
KillMode=process
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
