# systemd EnvironmentFile syntax; copy privately, do not commit credentials.
# First-run setup: no default account. Keep this state outside the executable.
ADMIN_ACCOUNT_FILE=/root/backup-monitor/admin_account.json
AUTH_REMOVE_LEGACY_ENV=false
# Existing ADMIN_USER/ADMIN_PASSWORD migrate once to a bcrypt hash. After
# verifying migration, remove those legacy variables from your EnvironmentFile.
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_CHARACTERS
API_BIND_ADDR=127.0.0.1:8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Existing API uses SSH for server operations even when hosted on that server.
SSH_HOST=192.168.37.130:22
SSH_USER=root
ALLOW_ROOT_SSH=true
SSH_PASSWORD=REPLACE_WITH_EXISTING_SSH_PASSWORD
SSH_KNOWN_HOSTS=/root/backup-monitor/known_hosts
SSH_INSECURE_IGNORE_HOST_KEY=false
# Persistent rules, delivery queue and staged-restore ownership (no database).
OPERATIONS_STATE_FILE=/root/backup-monitor/operations_state.json
# Enable on ONE backend only; disable on additional Windows/Docker test instances.
OPERATIONS_WORKER_ENABLED=true
MONITOR_TIMEZONE=Asia/Ho_Chi_Minh
